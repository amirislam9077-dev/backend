RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
PORT=8081

# MySQL (orders database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kstu_orders

# Login for the website admin orders page (/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Aiven: encrypted connection + its CA certificate file
DB_SSL=false
DB_SSL_CA_FILE=aiven-ca.pem

# Time zone for order times (Pakistan = +05:00)
DB_TIMEZONE=+05:00

# Customer emails (order confirmed / shipped). Either:
# Brevo: verify a sender email in Brevo, then set both
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# or Resend with a verified domain, e.g. Khurram Studio <orders@yourdomain.com>
EMAIL_FROM=
